# Database — Neon Postgres (khi deploy trên Railway)
# DATABASE_URL: chuỗi POOLED của Neon (host có "-pooler"), dùng cho app runtime.
# DIRECT_URL:   chuỗi DIRECT của Neon (không pooler), dùng cho `prisma db push`/migrate.
# Lấy trong Neon Console → Connection Details (nhớ ?sslmode=require).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth (đặt cả hai cho tương thích v4/v5; sinh bằng `openssl rand -base64 32`)
# Trên Railway đặt NEXTAUTH_URL/AUTH_URL = domain công khai của service.
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
AUTH_SECRET="dùng-cùng-giá-trị-với-NEXTAUTH_SECRET"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ShopVPS <noreply@shopvps.com>"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# VPS — khu vực mặc định khi đặt mua không chọn (tùy chọn)
DEFAULT_VPS_REGION="sgp"

# SePay
SEPAY_ACCOUNT_NUMBER=""
SEPAY_BANK_CODE=""
SEPAY_WEBHOOK_SECRET=""

# Encryption (for passwords stored in DB)
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# reCAPTCHA
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ShopVPS"
