# Database
DATABASE_URL="postgresql://user:password@localhost:5432/shopvps"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ShopVPS <noreply@shopvps.com>"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# VPS — khu vực mặc định khi đặt mua không chọn (tùy chọn)
DEFAULT_VPS_REGION="sgp"

# SePay
SEPAY_ACCOUNT_NUMBER=""
SEPAY_BANK_CODE=""
SEPAY_WEBHOOK_SECRET=""

# Encryption (for passwords stored in DB)
ENCRYPTION_KEY="your-32-char-encryption-key-here"

# reCAPTCHA
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ShopVPS"
